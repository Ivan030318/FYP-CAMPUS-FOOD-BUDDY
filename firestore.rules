rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} — profile is readable by any signed-in student (needed to build the
    // match list) but only editable by its owner.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    // foodBuddyRequests/{id} — only the two parties involved can see or act on a request.
    match /foodBuddyRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.requester_id == request.auth.uid ||
         resource.data.recipient_id == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.requester_id == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() &&
        (resource.data.requester_id == request.auth.uid ||
         resource.data.recipient_id == request.auth.uid);
      allow delete: if false;
    }

    // chats/{id} — only members of the chat (user_ids) can read/write it.
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.user_ids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.user_ids;
      allow update: if isSignedIn() && request.auth.uid in resource.data.user_ids;
      allow delete: if false;

      // chats/{id}/messages/{id} — only chat members can read/send messages, and the
      // sender_id must match the caller so users can't send as someone else.
      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.user_ids;
        allow create: if isSignedIn() &&
          request.resource.data.sender_id == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.user_ids;
        allow update: if false;
        allow delete: if false;
      }
    }

    // reports/{id} — any signed-in user can file a report about another user; reports are
    // not readable from the client (admin review happens via the Firebase console for this
    // prototype — a dedicated admin app/back office is future work beyond FYP2 core scope).
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporter_id == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
