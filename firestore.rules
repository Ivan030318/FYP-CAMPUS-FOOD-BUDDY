rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isChatMember(chat) { return isSignedIn() && request.auth.uid in chat.data.user_ids; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    function isActiveUser() {
      return isSignedIn()
        && !exists(/databases/$(database)/documents/accountSuspensions/$(request.auth.uid));
    }
    function isValidPublicProfile(data, uid) {
      return data.user_id == uid
        && data.display_name is string
        && data.display_name.size() >= 2
        && data.display_name.size() <= 50
        && data.profile_photo_url == null
        && data.food_preferences is list
        && data.food_preferences.hasOnly([
          'No Specific Preference', 'Halal Food', 'Vegetarian Food', 'Seafood', 'Western Food', 'Asian Food'
        ])
        && data.available_meal_times is list
        && data.available_meal_times.hasOnly([
          'Breakfast', 'Lunch', 'Tea Break / Afternoon Snack', 'Dinner'
        ])
        && data.dining_location is string
        && data.dining_location.size() <= 100
        && data.created_at is number;
    }

    // Public matching data only. Email and blocked users live in privateUsers/{uid}.
    match /users/{uid} {
      allow read: if isSignedIn() && (isActiveUser() || isAdmin());
      allow create: if isSelf(uid) && isActiveUser()
        && request.resource.data.keys().hasOnly([
          'user_id', 'display_name', 'profile_photo_url', 'food_preferences',
          'available_meal_times', 'dining_location', 'created_at'
        ])
        && isValidPublicProfile(request.resource.data, uid);
      allow update: if isSelf(uid) && isActiveUser()
        && request.resource.data.keys().hasOnly([
          'user_id', 'display_name', 'profile_photo_url', 'food_preferences',
          'available_meal_times', 'dining_location', 'created_at'
        ])
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && isValidPublicProfile(request.resource.data, uid);
      allow delete: if false;
    }

    // Never readable by another user; keeps email and block list out of match queries.
    match /privateUsers/{uid} {
      allow read: if isSelf(uid) && isActiveUser();
      allow create, update: if isSelf(uid) && isActiveUser()
        && request.resource.data.keys().hasOnly(['university_email', 'blocked_users']);
      allow delete: if false;
    }

    match /foodBuddyRequests/{requestId} {
      allow read: if isAdmin() || (isActiveUser()
        && (resource.data.requester_id == request.auth.uid || resource.data.recipient_id == request.auth.uid));

      // The deterministic pair id is supplied by the client; each document can only be created once.
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'participant_ids', 'requester_id', 'recipient_id', 'status', 'created_at'
        ])
        && request.resource.data.requester_id == request.auth.uid
        && request.resource.data.requester_id != request.resource.data.recipient_id
        && request.resource.data.participant_ids.size() == 2
        && request.resource.data.participant_ids[0] < request.resource.data.participant_ids[1]
        && request.resource.data.participant_ids.hasAll([
          request.resource.data.requester_id, request.resource.data.recipient_id
        ])
        && requestId == request.resource.data.participant_ids[0] + '_' + request.resource.data.participant_ids[1]
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.requester_id + '_' + request.resource.data.recipient_id))
        && !exists(/databases/$(database)/documents/blocks/$(request.resource.data.recipient_id + '_' + request.resource.data.requester_id))
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at is number;

      // Only the recipient may make the one-way pending -> accepted/rejected decision.
      allow update: if isActiveUser()
        && resource.data.recipient_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at'])
        && (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')
        && request.resource.data.responded_at is number;
      // The sender can withdraw an unanswered request; accepted/rejected records stay immutable.
      allow delete: if isActiveUser()
        && resource.data.requester_id == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Block records are never readable from the client. Rules use exists() above to reject
    // requests in either direction when either student has blocked the other.
    match /blocks/{blockId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['blocker_id', 'blocked_id', 'created_at'])
        && request.resource.data.blocker_id == request.auth.uid
        && request.resource.data.blocker_id != request.resource.data.blocked_id
        && blockId == request.resource.data.blocker_id + '_' + request.resource.data.blocked_id;
      allow delete: if isActiveUser() && resource.data.blocker_id == request.auth.uid;
      allow read, update: if false;
    }

    match /chats/{chatId} {
      allow read: if isActiveUser() && isChatMember(resource);

      // Chat ID must equal request ID and is only created in the recipient's accept transaction.
      allow create: if isActiveUser()
        && chatId == request.resource.data.request_id
        && request.resource.data.keys().hasOnly([
          'request_id', 'user_ids', 'last_message_preview', 'last_message_time',
          'last_message_sender_id', 'last_read_at'
        ])
        && getAfter(/databases/$(database)/documents/foodBuddyRequests/$(chatId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/foodBuddyRequests/$(chatId)).data.recipient_id == request.auth.uid
        && request.resource.data.user_ids.size() == 2
        && request.resource.data.user_ids.hasAll([
          getAfter(/databases/$(database)/documents/foodBuddyRequests/$(chatId)).data.requester_id,
          getAfter(/databases/$(database)/documents/foodBuddyRequests/$(chatId)).data.recipient_id
        ])
        && request.resource.data.last_message_sender_id is string
        && request.resource.data.last_read_at is map;

      // Participants and request linkage can never be changed after creation.
      allow update: if isActiveUser() && isChatMember(resource)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'last_message_preview', 'last_message_time', 'last_message_sender_id', 'last_read_at'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isActiveUser() && isChatMember(get(/databases/$(database)/documents/chats/$(chatId)));
        allow create: if isActiveUser() && isChatMember(get(/databases/$(database)/documents/chats/$(chatId)))
          && request.resource.data.keys().hasOnly(['chat_id', 'sender_id', 'text_content', 'sent_at'])
          && request.resource.data.chat_id == chatId
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.text_content.size() > 0
        && request.resource.data.text_content.size() <= 1000
        && request.resource.data.sent_at is number;
        allow update, delete: if false;
      }
    }

    // An admin role is assigned manually in Firebase Console. Clients cannot create roles.
    match /adminUsers/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;
    }

    // Only an administrator can suspend or restore an account. A suspended student may
    // still read their own status so the app can show a clear explanation rather than an error.
    match /accountSuspensions/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['user_id', 'reason', 'suspended_at', 'suspended_by'])
        && request.resource.data.user_id == uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.suspended_at is number
        && request.resource.data.suspended_by == request.auth.uid;
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'reporter_id', 'reported_user_id', 'reason', 'status', 'submitted_at'
        ])
        && request.resource.data.reporter_id == request.auth.uid
        && request.resource.data.reporter_id != request.resource.data.reported_user_id
        && reportId == request.resource.data.reporter_id + '_' + request.resource.data.reported_user_id
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.submitted_at is number;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolved_at', 'resolved_by'
        ])
        && request.resource.data.status == 'resolved'
        && request.resource.data.resolved_at is number
        && request.resource.data.resolved_by == request.auth.uid;
      allow delete: if false;
    }
  }
}
