# Copy this file to .env and fill in the values from your Firebase project
# (Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration).
#
# Also enable in the Firebase Console:
#   - Authentication -> Sign-in method -> Email/Password
#   - Firestore Database (start in production mode, then apply firestore.rules)
#
# After editing .env, restart the dev server with: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
